rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@bagateargo.store';
    }

    // Catalogue: anyone can browse, only the admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery zones: public read, admin writes
    match /serviceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: owner only
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Orders: customers create/read their own; admin reads/updates all
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
